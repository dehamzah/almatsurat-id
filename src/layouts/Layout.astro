---
import "../styles/global.css";
import { DEFAULT_SETTINGS } from "../store/settings";
import { pwaInfo } from "virtual:pwa-info";
import PwaToast from "../components/PwaToast.svelte";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Dzikir Harian Muslim" } = Astro.props;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="theme-color" content="#FDFBF7" />
        <meta name="apple-mobile-web-app-title" content="Al Ma'tsurat" />
        <link rel="manifest" href="/site.webmanifest" />

        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{title}</title>

        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

        {/* Blocking script to avoid FOUC */}
        <script is:inline define:vars={{ DEFAULT_SETTINGS }}>
            (function () {
                try {
                    // 1. Theme
                    const theme =
                        localStorage.getItem("settings:theme") ||
                        DEFAULT_SETTINGS.theme;

                    const colors = {
                        light: "#FDFBF7",
                        dark: "#0c0a09",
                    };
                    const isDark =
                        theme === "dark" ||
                        (!theme &&
                            window.matchMedia("(prefers-color-scheme: dark)")
                                .matches) ||
                        (theme === "auto" &&
                            window.matchMedia("(prefers-color-scheme: dark)")
                                .matches);

                    if (isDark) {
                        document.documentElement.classList.add("dark");
                        document
                            .querySelector('meta[name="theme-color"]')
                            .setAttribute("content", colors.dark);
                    } else {
                        document.documentElement.classList.remove("dark");
                        document
                            .querySelector('meta[name="theme-color"]')
                            .setAttribute("content", colors.light);
                    }

                    // 2. Font Size
                    const fontSize =
                        localStorage.getItem("settings:arabicFontSize") ||
                        DEFAULT_SETTINGS.arabicFontSize;
                    const sizes = {
                        "1": "1.5rem",
                        "2": "1.875rem",
                        "3": "2.25rem",
                        "4": "3rem",
                        "5": "3.75rem",
                    };
                    const sizeVal = sizes[fontSize] || "1.875rem";
                    document.documentElement.style.setProperty(
                        "--arabic-size",
                        sizeVal,
                    );

                    // 3. Visibility
                    const showTransliteration =
                        localStorage.getItem("settings:showTransliteration") ||
                        DEFAULT_SETTINGS.showTransliteration;
                    if (showTransliteration === "false") {
                        document.documentElement.classList.add(
                            "hide-transliteration",
                        );
                    }

                    const showTranslation =
                        localStorage.getItem("settings:showTranslation") ||
                        DEFAULT_SETTINGS.showTranslation;
                    if (showTranslation === "false") {
                        document.documentElement.classList.add(
                            "hide-translation",
                        );
                    }
                } catch (e) {
                    console.error("Error applying settings:", e);
                }
            })();
        </script>

        {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && import.meta.env.MODE === 'production' && <script is:inline define:vars={{ GA_ID: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
            (function () {
                try {
                    const GA_ID = GA_ID;
                    // Ensure we only load in production and when GA_ID is present
                    if (!GA_ID) return;

                    const s = document.createElement('script');
                    s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
                    s.async = true;
                    document.head.appendChild(s);

                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);} // eslint-disable-line no-unused-vars
                    gtag('js', new Date());
                    gtag('config', GA_ID, { anonymize_ip: true });
                } catch (e) {
                    console.error('GA load error:', e);
                }
            })();
        </script>}
    </head>
    <body
        class="min-h-screen bg-cream-50 dark:bg-stone-950 text-stone-800 dark:text-stone-100 font-sans selection:bg-emerald-200 selection:text-emerald-900"
    >
        <slot />
        <PwaToast client:idle />
    </body>
</html>
