---
import { BASMALLAH } from "../data/adhkar";
import type { DhikrItem } from "../types";
import SimpleSeparator from "./SimpleSeparator.astro";

interface Props {
    data: DhikrItem;
    index: number;
}

const { data, index } = Astro.props;

const combinedArabic = data.children.map((c) => c.arabic).join(" ");
const combinedTransliteration = data.children
    .map((c) => c.transliteration)
    .join(" ");
const combinedTranslation = data.children.map((c) => c.translation).join(" ");
---

<article
    class:list={[
        "w-full mx-auto dhikr-card transition-transform duration-100 group",
        data.repeat > 0 ? "cursor-pointer select-none touch-manipulation" : "",
    ]}
    data-repeat={data.repeat}
>
    <div
        class="flex flex-col items-center justify-center text-center px-2 md:px-0"
    >
        {/* Header Info */}
        <div class="mb-6 flex flex-col items-center gap-2">
            <h2
                class="font-sans font-bold text-emerald-900 dark:text-stone-300 text-sm tracking-widest uppercase"
            >
                {data.title}
            </h2>
            {
                data.repeat > 0 && (
                    <div class="dhikr-count-display text-xs text-emerald-600 dark:text-emerald-200 font-serif italic font-medium flex items-center justify-center overflow-hidden h-5">
                        <span class="dhikr-count-current translate-y-0">0</span>
                        <span class="mx-1">/</span>
                        <span>{data.repeat}x</span>
                    </div>
                )
            }
        </div>

        {/* Arabic Text */}
        <div class="w-full mb-8" dir="rtl">
            {
                data.hasPrefixBasmallah && (
                    <p
                        lang="ar"
                        class="animate-enter opacity-0 font-arabic text-stone-900 dark:text-stone-300 transition-all duration-300"
                        style={`animation-delay: ${index * 50}ms; animation-fill-mode: forwards;`}
                    >
                        {BASMALLAH}
                    </p>
                )
            }
            <p
                lang="ar"
                class="animate-enter opacity-0 font-arabic text-stone-900 dark:text-stone-300 transition-all duration-300"
                style={`animation-delay: ${index * 50}ms; animation-fill-mode: forwards;`}
            >
                {combinedArabic}
            </p>
        </div>

        {/* Transliteration & Translation */}
        <div class="space-y-6 max-w-xl mx-auto w-full">
            {/* Transliteration */}
            {
                combinedTransliteration && (
                    <div class="transliteration transition-all duration-500">
                        <div class="text-emerald-800 dark:text-emerald-200 italic text-sm md:text-base leading-relaxed pb-2">
                            {combinedTransliteration}
                        </div>
                    </div>
                )
            }

            {/* Translation */}
            <div class="translation transition-all duration-500">
                <div
                    class="text-stone-800 dark:text-stone-400 text-sm md:text-base leading-relaxed pb-2"
                >
                    {combinedTranslation}
                </div>
            </div>
        </div>

        {
            data.note && (
                <div class="mt-6 text-xs text-stone-400 dark:text-stone-500 italic max-w-lg mx-auto">
                    <span class="font-bold">Keutamaan:</span> {data.note}
                </div>
            )
        }

        {/* Separator */}
        <SimpleSeparator />
    </div>
</article>

<script>
    function initDhikrCounters() {
        const cards = document.querySelectorAll(".dhikr-card");
        cards.forEach((card) => {
            if (!(card instanceof HTMLElement)) return;

            // Prevent double initialization
            if (card.dataset.initialized === "true") return;

            const repeat = parseInt(card.dataset.repeat || "0");
            if (repeat <= 0) return;

            card.dataset.initialized = "true";

            const displayContainer = card.querySelector(".dhikr-count-display");
            const currentCountSpan = card.querySelector(".dhikr-count-current");

            let count = 0;

            card.addEventListener("click", () => {
                if (count < repeat) {
                    count++;

                    if (currentCountSpan instanceof HTMLElement) {
                        currentCountSpan.textContent = count.toString();

                        // Trigger reflow for animation restart
                        currentCountSpan.classList.remove("animate-count-up");
                        void currentCountSpan.offsetWidth;
                        currentCountSpan.classList.add("animate-count-up");
                    }

                    // Haptic feedback
                    if (navigator && navigator.vibrate) {
                        if (count === repeat) {
                            navigator.vibrate(50);
                            displayContainer?.classList.add(
                                "font-bold",
                                "text-emerald-700",
                                "dark:text-emerald-100",
                            );
                        } else {
                            navigator.vibrate(10);
                        }
                    }
                }
            });
        });
    }

    // Run on load
    initDhikrCounters();

    // Run on Astro view transitions (if enabled later)
    document.addEventListener("astro:page-load", initDhikrCounters);
</script>

<style>
    @keyframes countUp {
        0% {
            transform: translateY(100%);
            opacity: 0;
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .animate-count-up {
        animation: countUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
</style>
