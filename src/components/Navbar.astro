---
import { ChevronLeft } from "lucide-svelte";
import SettingsToggle from "./SettingsToggle.svelte";
import AudioPlayer from "./AudioPlayer.svelte";
import { toCapitalized } from "../utils/string";

interface Props {
    mode: "pagi" | "petang";
    size: "sughro" | "kubro";
}

const { mode, size } = Astro.props;
const sizeCapitalized = toCapitalized(size);
---

{/* Header - Fixed Position */}
<div
    class="fixed top-0 left-0 right-0 z-40 bg-cream-50/80 dark:bg-stone-950/80 backdrop-blur-md border-b border-stone-200/50 dark:border-stone-800/50 transition-colors"
>
    <div class="max-w-2xl mx-auto px-2 py-4 flex items-center justify-between">
        <a
            href="/"
            aria-label="Go back"
            class="p-2 text-stone-600 dark:text-stone-300 hover:bg-stone-200/50 dark:hover:bg-stone-800/50 rounded-full transition-colors flex items-center gap-2"
        >
            <ChevronLeft size={20} />
        </a>

        <div class="flex flex-col items-center mr-[-36px]">
            <h1
                class="font-serif font-bold text-lg text-emerald-900 dark:text-stone-300 leading-none transition-colors"
            >
                {mode === "pagi" ? "Dzikir Pagi" : "Dzikir Petang"}

                <span
                    class="block text-center font-sans text-[10px] uppercase tracking-widest text-emerald-600 dark:text-emerald-200 mt-1 font-bold"
                >
                    {sizeCapitalized}
                </span>
            </h1>
        </div>

        <div class="flex items-center gap-1">
            <AudioPlayer client:visible mode={mode} size={size} />
            <SettingsToggle client:visible />
        </div>
    </div>
</div>
