---
import { ChevronLeft } from "lucide-svelte";
import SettingsToggle from "./SettingsToggle.svelte";

interface Props {
    mode: "pagi" | "petang";
    size: "sughro" | "kubro";
}

const { mode, size } = Astro.props;
---

{/* Header - Fixed Position */}
<div
    class="fixed top-0 left-0 right-0 z-40 bg-cream-50/95 dark:bg-stone-950/95 backdrop-blur-md border-b border-stone-200/50 dark:border-stone-800/50 transition-colors"
>
    <div class="max-w-2xl mx-auto px-2 py-4 flex items-center justify-between">
        <a
            href="/"
            aria-label="Go back"
            class="p-2 text-stone-600 dark:text-stone-300 hover:bg-stone-200/50 dark:hover:bg-stone-800/50 rounded-full transition-colors flex items-center gap-2"
        >
            <ChevronLeft size={20} />
        </a>

        <div class="flex flex-col items-center">
            <h2
                class="font-serif font-bold text-lg text-emerald-900 dark:text-emerald-100 leading-none transition-colors"
            >
                {mode === "pagi" ? "Dzikir Pagi" : "Dzikir Petang"}
            </h2>
            <span
                class="text-[10px] uppercase tracking-widest text-emerald-600/70 dark:text-emerald-400/70 mt-1 font-bold"
            >
                {size}
            </span>
        </div>

        <SettingsToggle client:visible />
    </div>
</div>
