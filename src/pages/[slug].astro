---
import Layout from "../layouts/Layout.astro";
import DhikrCard from "../components/DhikrCard.astro";
import Navbar from "../components/Navbar.astro";
import ShareCard from "../components/ShareCard.svelte";
import FeedbackCard from "../components/FeedbackCard.astro";

import SettingsModal from "../components/SettingsModal.svelte";
import { ADHKAR_DATA } from "../data/adhkar";
import { Sun, Moon } from "lucide-svelte";
import Container from "../components/Container.astro";
import { toCapitalized } from "../utils/string";

export function getStaticPaths() {
    const routes = [
        { slug: "dzikir-pagi-sughro", mode: "pagi", size: "sughro" },
        { slug: "dzikir-pagi-kubro", mode: "pagi", size: "kubro" },
        { slug: "dzikir-petang-sughro", mode: "petang", size: "sughro" },
        { slug: "dzikir-petang-kubro", mode: "petang", size: "kubro" },
    ];
    return routes.map((route) => ({
        params: { slug: route.slug },
        props: { mode: route.mode, size: route.size },
    }));
}

interface Props {
    mode: "pagi" | "petang";
    size: "sughro" | "kubro";
}

const { mode, size } = Astro.props;

// Filter Data
const filteredDhikr = ADHKAR_DATA.filter((d) => {
    return d.tags.includes(mode) && d.tags.includes(size);
});

const modeCapitalized = toCapitalized(mode);
const sizeCapitalized = toCapitalized(size);

const pageTitle = `Al Ma'tsurat ${modeCapitalized} ${sizeCapitalized}`;
const pageDescription = `Bacaan lengkap Al Ma'tsurat ${modeCapitalized} ${sizeCapitalized}. Kumpulan dzikir dan doa harian yang disusun oleh Hasan Al Banna, lengkap dengan audio.`;
---

<Layout title={pageTitle} description={pageDescription}>
    <Container>
        <div class="w-full pb-32 pt-24">
            <Navbar mode={mode} size={size} />

            {/* List Content Wrapper */}
            <main>
                <div class="px-4">
                    {
                        filteredDhikr.map((dhikr, index) => (
                            <DhikrCard data={dhikr} index={index + 1} />
                        ))
                    }
                </div>

                {/* Completion Footer */}
                <div class="mt-16 text-center px-4 mb-20">
                    <div
                        class="inline-block p-4 mb-4 transition-colors text-emerald-800 dark:text-emerald-300 opacity-50"
                    >
                        <div class="w-8 h-8 flex items-center justify-center">
                            {
                                mode === "pagi" ? (
                                    <Sun size={24} strokeWidth={1} />
                                ) : (
                                    <Moon size={24} strokeWidth={1} />
                                )
                            }
                        </div>
                    </div>
                    <h3
                        class="font-arabic font-bold text-2xl text-stone-800 dark:text-stone-200 mb-2 transition-colors"
                    >
                        ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ
                    </h3>
                    <p
                        class="text-stone-800 dark:text-stone-300 text-sm mb-8 transition-colors italic"
                    >
                        Semoga Allah menerima amalanmu.
                    </p>

                    <div class="flex flex-col gap-4 items-center">
                        <ShareCard client:visible />
                        <FeedbackCard />
                    </div>
                </div>
            </main>
        </div>
    </Container>

    <SettingsModal client:idle />
</Layout>
