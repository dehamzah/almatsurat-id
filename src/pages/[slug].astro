---
import Layout from "../layouts/Layout.astro";
import DhikrCard from "../components/DhikrCard.astro";
import ShareCard from "../components/ShareCard.svelte";
import SettingsToggle from "../components/SettingsToggle.svelte";
import SettingsModal from "../components/SettingsModal.svelte";
import { ADHKAR_DATA } from "../data/adhkar";
import { ChevronLeft, Sun, Moon } from "lucide-svelte";

export function getStaticPaths() {
    const routes = [
        { slug: "dzikir-pagi-sughro", mode: "pagi", size: "sughro" },
        { slug: "dzikir-pagi-kubro", mode: "pagi", size: "kubro" },
        { slug: "dzikir-sore-sughro", mode: "sore", size: "sughro" },
        { slug: "dzikir-sore-kubro", mode: "sore", size: "kubro" },
    ];
    return routes.map((route) => ({
        params: { slug: route.slug },
        props: { mode: route.mode, size: route.size },
    }));
}

const { mode, size } = Astro.props;
const { slug } = Astro.params;

// Filter Data
const timeTag = mode === "sore" ? "petang" : "pagi";
const filteredDhikr = ADHKAR_DATA.filter((d) => {
    return d.tags.includes(timeTag) && d.tags.includes(size);
});

const pageTitle = `${mode === "pagi" ? "Dzikir Pagi" : "Dzikir Petang"} (${size}) | Al Ma'tsurat`;
const pageDescription = `Read the ${mode} dhikr (${size}) - Dzikir Harian Muslim`;
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="w-full pb-32 pt-24">
        {/* Header - Fixed Position */}
        <div
            class="fixed top-0 left-0 right-0 z-40 bg-cream-50/95 dark:bg-stone-950/95 backdrop-blur-md border-b border-stone-200/50 dark:border-stone-800/50 transition-colors"
        >
            <div
                class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between"
            >
                <a
                    href="/"
                    aria-label="Go back"
                    class="p-2 -ml-2 text-stone-600 dark:text-stone-300 hover:bg-stone-200/50 dark:hover:bg-stone-800/50 rounded-full transition-colors flex items-center gap-2"
                >
                    <ChevronLeft size={20} />
                </a>

                <div class="flex flex-col items-center">
                    <h2
                        class="font-serif font-bold text-lg text-emerald-900 dark:text-emerald-100 leading-none transition-colors"
                    >
                        {mode === "pagi" ? "Dzikir Pagi" : "Dzikir Petang"}
                    </h2>
                    <span
                        class="text-[10px] uppercase tracking-widest text-emerald-600/70 dark:text-emerald-400/70 mt-1 font-bold"
                    >
                        {size}
                    </span>
                </div>

                <SettingsToggle client:visible />
            </div>
        </div>

        {/* List Content Wrapper */}
        <div class="animate-slide-up">
            <div class="px-4">
                {
                    filteredDhikr.map((dhikr, index) => (
                        <DhikrCard data={dhikr} index={index + 1} />
                    ))
                }
            </div>

            {/* Completion Footer */}
            <div class="mt-16 text-center px-4 mb-20">
                <div
                    class="inline-block p-4 mb-4 transition-colors text-emerald-800 dark:text-emerald-300 opacity-50"
                >
                    <div class="w-8 h-8 flex items-center justify-center">
                        {
                            mode === "pagi" ? (
                                <Sun size={24} strokeWidth={1} />
                            ) : (
                                <Moon size={24} strokeWidth={1} />
                            )
                        }
                    </div>
                </div>
                <h3
                    class="font-serif font-bold text-xl text-emerald-900 dark:text-emerald-100 mb-2 transition-colors"
                >
                    Selesai
                </h3>
                <p
                    class="text-stone-500 dark:text-stone-400 text-sm mb-8 transition-colors italic"
                >
                    Semoga Allah menerima amalanmu.
                </p>

                <div class="flex flex-col gap-4 items-center">
                    {/* Share Section */}
                    {/* ShareCard needs client side interaction */}
                    {/* <ShareCard client:visible /> */}
                </div>
            </div>
        </div>
    </div>

    <SettingsModal client:idle />
</Layout>
