---
import Layout from "../layouts/Layout.astro";
import IslamicArtBackground from "../components/IslamicArtBackground.astro";
import GeometricPattern from "../components/GeometricPattern.astro";
import SettingsToggle from "../components/SettingsToggle.svelte";
import SettingsModal from "../components/SettingsModal.svelte";
import { Sun, Moon } from "lucide-svelte";

// SEO
const title = "Al Ma'tsurat | Daily Adhkar";
const description = "Daily Prophetic Remembrances - Dzikir Pagi dan Petang";
---

<Layout title={title} description={description}>
	{/* Background Art - Static Render */}
	<IslamicArtBackground />

	{/* Header with Settings */}
	<nav class="absolute top-0 right-0 p-4 z-20">
		<SettingsToggle client:load />
	</nav>

	<div
		class="w-full flex flex-col items-center justify-center min-h-[90vh] px-4 animate-fade-in relative z-10 py-6 md:py-12"
	>
		{/* Minimal Header */}
		<div class="mb-6 md:mb-8 text-center mt-8">
			<h1
				class="font-serif font-bold text-4xl md:text-5xl text-emerald-950 dark:text-emerald-50 mb-2 md:mb-3 transition-colors"
			>
				Al Ma'tsurat
			</h1>
			<p
				class="font-serif italic text-stone-500 dark:text-stone-400 text-base md:text-lg transition-colors"
			>
				Dzikir dan Doa Rasulullah
			</p>
		</div>

		{/* Dhikr Size Toggles */}
		<div class="flex gap-8 md:gap-10 mb-8 md:mb-12" id="size-toggles">
			<button
				data-size="sughro"
				class="size-btn pb-1 text-base md:text-lg font-serif transition-all duration-300 border-b-2 font-medium text-emerald-900 dark:text-emerald-100 border-emerald-900 dark:border-emerald-100"
			>
				Sughro
			</button>
			<button
				data-size="kubro"
				class="size-btn pb-1 text-base md:text-lg font-serif transition-all duration-300 border-b-2 font-medium text-stone-400 dark:text-stone-500 border-transparent hover:text-stone-600 dark:hover:text-stone-300"
			>
				Kubro
			</button>
		</div>

		{/* Selection Buttons */}
		<div class="grid grid-cols-2 gap-4 md:gap-8 w-full max-w-3xl px-2">
			{/* Morning Button */}
			<a
				href="/dzikir-pagi-sughro"
				id="link-pagi"
				class="group relative flex flex-col items-center justify-center p-6 md:p-10 border border-stone-200 dark:border-stone-800 hover:border-emerald-400 dark:hover:border-emerald-600 rounded-xl transition-all duration-300 bg-white/50 dark:bg-stone-900/50 hover:bg-white dark:hover:bg-stone-900 hover:shadow-lg hover:shadow-emerald-100 dark:hover:shadow-emerald-900/10 text-center overflow-hidden"
			>
				{/* Corner Pattern (React Component) */}
				<div
					class="absolute top-0 right-0 w-16 h-16 md:w-24 md:h-24 text-stone-100 dark:text-stone-800 group-hover:text-amber-50 dark:group-hover:text-amber-900/10 transition-colors duration-500 -mr-4 -mt-4"
				>
					<GeometricPattern className="" />
				</div>

				<div
					class="relative z-10 mb-3 md:mb-5 text-stone-400 dark:text-stone-500 group-hover:text-amber-500 dark:group-hover:text-amber-400 transition-colors duration-300 transform group-hover:scale-110"
				>
					<Sun
						size={32}
						className="md:w-12 md:h-12"
						strokeWidth={1.5}
					/>
				</div>

				<h2
					class="relative z-10 text-xl md:text-2xl font-serif font-bold text-stone-700 dark:text-stone-200 mb-1 group-hover:text-emerald-900 dark:group-hover:text-emerald-50 transition-colors"
				>
					Dzikir Pagi
				</h2>
				<p
					class="relative z-10 text-stone-400 dark:text-stone-500 text-[10px] md:text-xs uppercase tracking-[0.15em] font-medium group-hover:text-amber-600/70 dark:group-hover:text-amber-400/70 transition-colors"
				>
					Dibaca Setelah Shubuh
				</p>
			</a>

			{/* Evening Button */}
			<a
				href="/dzikir-sore-sughro"
				id="link-sore"
				class="group relative flex flex-col items-center justify-center p-6 md:p-10 border border-stone-200 dark:border-stone-800 hover:border-emerald-400 dark:hover:border-emerald-600 rounded-xl transition-all duration-300 bg-white/50 dark:bg-stone-900/50 hover:bg-white dark:hover:bg-stone-900 hover:shadow-lg hover:shadow-emerald-100 dark:hover:shadow-emerald-900/10 text-center overflow-hidden"
			>
				{/* Corner Pattern */}
				<div
					class="absolute top-0 right-0 w-16 h-16 md:w-24 md:h-24 text-stone-100 dark:text-stone-800 group-hover:text-indigo-50 dark:group-hover:text-indigo-900/10 transition-colors duration-500 -mr-4 -mt-4"
				>
					<GeometricPattern className="transform rotate-90" />
				</div>

				<div
					class="relative z-10 mb-3 md:mb-5 text-stone-400 dark:text-stone-500 group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors duration-300 transform group-hover:scale-110"
				>
					<Moon
						size={32}
						className="md:w-12 md:h-12"
						strokeWidth={1.5}
					/>
				</div>

				<h2
					class="relative z-10 text-xl md:text-2xl font-serif font-bold text-stone-700 dark:text-stone-200 mb-1 group-hover:text-emerald-900 dark:group-hover:text-emerald-50 transition-colors"
				>
					Dzikir Petang
				</h2>
				<p
					class="relative z-10 text-stone-400 dark:text-stone-500 text-[10px] md:text-xs uppercase tracking-[0.15em] font-medium group-hover:text-indigo-600/70 dark:group-hover:text-indigo-400/70 transition-colors"
				>
					Dibaca Setelah Ashar
				</p>
			</a>
		</div>

		{/* Footer Citation */}
		<div class="mt-12 md:mt-24 mb-6 flex flex-col items-center opacity-80">
			<div
				class="w-12 h-px bg-gradient-to-r from-transparent via-emerald-800/20 dark:via-emerald-100/20 to-transparent mb-3"
			>
			</div>
			<p
				class="text-[10px] uppercase tracking-[0.2em] text-stone-500 dark:text-stone-300 font-sans mb-1"
			>
				Disusun Oleh
			</p>
			<p
				class="font-serif text-sm md:text-base text-emerald-900/80 dark:text-emerald-100/80 italic"
			>
				Imam Hasan al-Banna
			</p>
		</div>
	</div>

	<SettingsModal client:idle />
</Layout>

<script>
	import type { DhikrSize } from "../types";

	// Logic for Sughro/Kubro toggle
	let currentSize: DhikrSize =
		(localStorage.getItem("settings:dhikrSize") as DhikrSize) || "sughro";

	const updateLinks = (size: DhikrSize) => {
		const linkPagi = document.getElementById("link-pagi");
		const linkSore = document.getElementById("link-sore");
		if (linkPagi) linkPagi.setAttribute("href", `/dzikir-pagi-${size}`);
		if (linkSore) linkSore.setAttribute("href", `/dzikir-sore-${size}`);
	};

	const updateButtons = (size: DhikrSize) => {
		const btns = document.querySelectorAll(".size-btn");
		btns.forEach((btn) => {
			if (btn.getAttribute("data-size") === size) {
				// Active styles
				btn.className =
					"size-btn pb-1 text-base md:text-lg font-serif transition-all duration-300 border-b-2 font-medium text-emerald-900 dark:text-emerald-100 border-emerald-900 dark:border-emerald-100";
				btn.setAttribute("aria-pressed", "true");
			} else {
				// Inactive styles
				btn.className =
					"size-btn pb-1 text-base md:text-lg font-serif transition-all duration-300 border-b-2 font-medium text-stone-400 dark:text-stone-500 border-transparent hover:text-stone-600 dark:hover:text-stone-300";
				btn.setAttribute("aria-pressed", "false");
			}
		});
	};

	// Initialize
	updateLinks(currentSize);
	updateButtons(currentSize);

	// Event Listeners
	document.querySelectorAll(".size-btn").forEach((btn) => {
		btn.addEventListener("click", (e) => {
			const size = (e.target as HTMLElement).getAttribute(
				"data-size",
			) as DhikrSize;
			if (size) {
				currentSize = size;
				localStorage.setItem("settings:dhikrSize", size);
				updateLinks(size);
				updateButtons(size);
			}
		});
	});
</script>
