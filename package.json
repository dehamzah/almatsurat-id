{
  "name": "almatsurat-id",
  "type": "module",
  "version": "2.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4320",
    "astro": "astro",
    "audit": "bun run build && start-server-and-test preview http://localhost:4321 'lighthouse http://localhost:4321 --view --no-enable-error-reporting'",
    "check": "bun run astro check && bun run svelte-check",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/svelte": "^7.2.3",
    "@nanostores/persistent": "^1.2.0",
    "@sentry/astro": "^10.32.1",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.5",
    "lucide-svelte": "^0.561.0",
    "nanostores": "^1.1.0",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vite-pwa/astro": "^1.2.0",
    "lighthouse": "^13.0.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "start-server-and-test": "^2.1.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.55.0"
  }
}